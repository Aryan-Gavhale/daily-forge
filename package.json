{
  "name": "daily-forge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Forge - a local-first daily growth tracker PWA. Eight pillars, strict XP and streaks, beat-your-past-self stats.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "icons": "node scripts/make-icons.mjs",
    "build:pages": "cross-env BASE_PATH=/daily-forge/ vite build",
    "deploy": "npm run build:pages && gh-pages -d dist -b gh-pages"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "idb": "^8.0.2",
    "lenis": "^1.1.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  }
}
